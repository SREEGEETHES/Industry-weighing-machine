# Copy this file to .env and fill in real values.

DATABASE_URL=sqlite:///./data/iwpas.db

# Gmail SMTP example (use an App Password from your Google Account security
# settings, not your normal Gmail password - normal passwords are rejected
# by Gmail for SMTP since 2FA is required for app access).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraccount@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=IWPAS Reporting

REPORT_DAY_OF_WEEK=mon
REPORT_HOUR=7
REPORT_MINUTE=0

BOX_ID_PREFIX=BOX

STABILITY_SAMPLE_COUNT=5
STABILITY_TOLERANCE_KG=0.010
STABILITY_POLL_INTERVAL_SEC=0.2
